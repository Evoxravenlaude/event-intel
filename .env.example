APP_NAME=event-intel-api
APP_ENV=development
DEBUG=true
PORT=8000
DATABASE_URL=sqlite:///./event_intel.db
DEFAULT_RADIUS_KM=10
SOURCE_TIMEOUT_SECONDS=20
ENABLE_MOCK_ADAPTERS=true

# Clustering — see app/services/clustering.py for the scoring model.
CLUSTER_DISTANCE_KM=1.5
CLUSTER_TIME_WINDOW_HOURS=12
# Hard vetoes: same-looking events this far apart in space/time are different events
CLUSTER_MAX_LINK_DISTANCE_KM=50
CLUSTER_MAX_LINK_TIME_DAYS=3
# score >= this → auto-link to the best event
CLUSTER_LINK_THRESHOLD=0.55
# review threshold <= score < link threshold → human review
CLUSTER_REVIEW_THRESHOLD=0.35
# only compare against events within ±N days of the signal
CLUSTER_CANDIDATE_WINDOW_DAYS=14
# max signals per cluster pass
CLUSTER_BATCH_SIZE=500
CONFIRMED_CONFIDENCE_THRESHOLD=0.75

# Geocoding (text <-> coordinates). Nominatim-compatible; no key needed.
# Nominatim's policy: identify yourself in the User-Agent and stay <= 1 req/s.
# Results are cached in the database; with the provider down, a built-in
# gazetteer of ~90 major cities keeps reverse lookups working.
GEOCODING_ENABLED=true
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=event-intel/1.1 (you@example.com)

# Google Maps Platform — optional, the most accurate option. Two separate keys:
#  * GOOGLE_MAPS_API_KEY (server): enable "Geocoding API" + "Places API (New)";
#    restrict the key to those two APIs. Used for reverse/forward geocoding and
#    place search; Nominatim/Photon take over automatically if it fails.
#  * GOOGLE_MAPS_BROWSER_KEY (shipped to the page via /config): enable "Maps JavaScript API"
#    only and restrict it by HTTP referrer to your domain (e.g. https://yourapp.com/*).
#    When unset the map uses Leaflet + OpenStreetMap tiles.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# Place-search fallback when there's no Google key (OSM-based, autocomplete-friendly)
PHOTON_URL=https://photon.komoot.io/api/
# Approximate location from the visitor's IP when GPS is denied ({ip} substituted)
IP_GEO_ENABLED=true
IP_GEO_URL=https://ipapi.co/{ip}/json/

# Public consumer app: GET /discover, /events, /config, /stats, /places/*, /geocode*
# work without the API key; writes, ingest, review and /signals still need it.
PUBLIC_READ=true
# Live scans triggered by anonymous visitors, per IP per hour (cached results are unlimited)
PUBLIC_SCANS_PER_HOUR=30

# Discovery — "what's around me"
DISCOVER_DEFAULT_RADIUS_KM=25
DISCOVER_MAX_RADIUS_KM=200
# An area scanned within this many minutes is served from the DB without re-scanning
DISCOVER_STALE_MINUTES=360
# Geo-capable sources a live scan runs (comma-separated). luma needs no key.
DISCOVER_SOURCES=luma,ticketmaster,seatgeek
# Scheduler "coverage" job re-scans areas requested within the last N days
COVERAGE_RESCAN_DAYS=7

# Luma city feeds — keyless; ~80 cities worldwide incl. Lagos, Nairobi, London, Singapore.
# A Luma city counts for a request if its centre is within radius + this many km.
LUMA_PLACE_REACH_KM=40

# Geo-capable global sources (free keys)
# Ticketmaster Discovery API — developer.ticketmaster.com — concerts/sports/theatre in 30+ countries
TICKETMASTER_API_KEY=
# SeatGeek Platform — platform.seatgeek.com — strongest in North America
SEATGEEK_CLIENT_ID=

# Auth — set a strong random string to enable API key enforcement.
# Requests must include header: X-API-Key: <value>  (or Authorization: Bearer <value>)
# Leave blank to disable in development.
API_KEY=

# CORS — comma-separated allowed origins. Use "*" to allow all (default).
# Set to your frontend domain in production: https://yourapp.com
CORS_ORIGINS_RAW=*

# Webhooks — comma-separated URLs to POST when an event first becomes confirmed
# (confidence crosses CONFIRMED_CONFIDENCE_THRESHOLD). Optional HMAC signing.
WEBHOOK_URLS=
WEBHOOK_SECRET=

# Embeddings — multilingual sentence embeddings for clustering.
# Model is downloaded on first use (~120MB; torch dependency is ~1GB).
# Set EMBEDDINGS_ENABLED=false to use Jaccard bag-of-words similarity instead.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_ENABLED=true

# Source credentials
# Eventbrite's public search API was retired; the API only lists events you own.
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_ORGANIZATION_ID=
# comma-separated .ics feeds or Luma page URLs
LUMA_FEED_URLS=
# comma-separated RSS/Atom feeds
TELEGRAM_FEED_URLS=
# comma-separated RSS/Atom feeds or linkedin.com/events/ URLs
LINKEDIN_SOURCE_URLS=
X_BEARER_TOKEN=
# RSS/Atom bridge feeds used when no bearer token
X_FEED_URLS=
# optional: en,fr,sw — blank searches all languages
X_LANGUAGES=

# Scheduler: JSON array of ingest jobs.
# Each: {"source": "luma", "city": "Lagos", "query": "web3", "interval_minutes": 60, "urls": []}
#   or  {"source": "ticketmaster", "lat": 6.5244, "lng": 3.3792, "radius_km": 50, "interval_minutes": 180}
#   or  {"source": "coverage", "interval_minutes": 120}   <- re-scan every area users looked at recently
SCHEDULER_SOURCES=
# Run the scheduler inside the API process (single-service deploys only).
# Leave false when a dedicated `scheduler` service runs, or every source is ingested twice.
SCHEDULER_IN_PROCESS=false
SCHEDULER_TICK_SECONDS=60
